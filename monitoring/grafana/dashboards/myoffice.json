            "type": "prometheus",
            "uid": "myoffice-prometheus"
          },
          "expr": "(sum by (kind) (rate(myoffice_rum_resources_total{page=~\"${page:regex}\",cached=\"true\"}[$__rate_interval])) or 0 * sum by (kind) (rate(myoffice_rum_resources_total{page=~\"${page:regex}\"}[$__rate_interval]))) / sum by (kind) (rate(myoffice_rum_resources_total{page=~\"${page:regex}\"}[$__rate_interval]))",
