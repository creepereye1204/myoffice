{
  "uid": "myoffice-requests",
  "title": "알오피스 — 요청 구간",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "page",
        "label": "페이지",
        "type": "custom",
        "query": "home,edit",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "home",
            "value": "home",
            "selected": false
          },
          {
            "text": "edit",
            "value": "edit",
            "selected": false
          }
        ],
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "barchart",
      "title": "브라우저 구간별 시간 p50",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myoffice-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "dns"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "DNS"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "connect"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "TCP 연결"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tls"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "TLS"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ttfb"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "서버 응답 대기 (TTFB)"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "download"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "다운로드"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "orientation": "horizontal",
        "stacking": "normal"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "myoffice-prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le, kind, segment) (increase(myoffice_rum_segment_seconds_bucket{page=~\"${page:regex}\",segment!=\"total\"}[$__range])))",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "description": "선택 기간 동안 수집한 종류별 구간 백분위수. 막대의 각 색상은 해당 구간의 독립적인 백분위수다.",
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "segment",
            "rowField": "kind",
            "valueField": "Value",
            "emptyValue": "null"
          }
        }
      ]
    },
